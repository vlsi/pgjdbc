{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hugo",
      "runtimeExecutable": "hugo",
      "runtimeArgs": ["server", "--source", "docs", "--port", "1313", "--bind", "127.0.0.1", "--disableFastRender"],
      "port": 1313
    },
    {
      "name": "doc-diff-public",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "1314", "--bind", "127.0.0.1", "--directory", "docs/public"],
      "port": 1314
    }
  ]
}
