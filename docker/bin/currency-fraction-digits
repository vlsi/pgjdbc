#!/usr/bin/env bash
set -euo pipefail

# Regenerates MoneyFractionDigits.java, the list of currency symbols whose locale prints three
# fraction digits.
#
# Why the driver needs it: money arrives as the server's lc_monetary rendering, and none of the
# properties that shape it travel with the value. One rendering is undecidable from its own shape --
# a single separator with exactly three digits after it and one to three before, "1,234" -- because
# a locale printing no fraction means 1234 and one printing three means 1.234. The currency symbol
# settles it, and this table is the lookup. See MoneyCodec.decimalSeparatorIndex.
#
# The table only has to answer "does this currency print three fraction digits", not reproduce the
# locale's formatting: a two-fraction-digit locale can never produce that rendering, since cash_out
# always prints exactly frac_digits decimals.
#
# Run it when the glibc the server images build on changes; the output names the version it came
# from, so a diff shows both the data and the provenance:
#
#     docker/bin/currency-fraction-digits > \
#       pgjdbc/src/main/java/org/postgresql/jdbc/codec/MoneyFractionDigits.java
#
#     IMAGE = base image to read locale data from - defaults to the one postgres-head builds on

IMAGE="${IMAGE:-debian:trixie-slim}"

docker run --rm -i "$IMAGE" bash -s <<'CONTAINER'
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq >/dev/null 2>&1
apt-get -y -qq install --no-install-recommends locales python3 >/dev/null 2>&1

glibc=$(dpkg-query -f '${Version}' -W libc6)

# Compile every territory locale and read the compiled LC_MONETARY, rather than parsing the source
# files: a locale may write its symbol as literal characters or as <Uxxxx> escapes, and only the
# compiled form is guaranteed to be what the server will print.
for f in /usr/share/i18n/locales/*; do
  locale_name=$(basename "$f")
  case "$locale_name" in *_*) ;; *) continue ;; esac
  localedef -i "$locale_name" -c -f UTF-8 "$locale_name.UTF-8" 2>/dev/null || continue
  monetary=$(LC_ALL="$locale_name.UTF-8" locale -k LC_MONETARY 2>/dev/null)
  frac=$(printf '%s\n' "$monetary" | sed -n 's/^frac_digits=//p')
  if [ "$frac" = "3" ]; then
    printf '%s\t%s\n' "$(printf '%s\n' "$monetary" | sed -n 's/^currency_symbol=//p' | tr -d '"')" \
      "$locale_name"
  fi
  localedef --delete-from-archive "$locale_name.UTF-8" 2>/dev/null
done > /tmp/three.tsv

python3 - "$glibc" <<'PY'
import sys, collections
glibc = sys.argv[1]
rows = [l.rstrip("\n").split("\t") for l in open("/tmp/three.tsv") if l.strip()]
by = collections.defaultdict(set)
for symbol, locale in rows:
    by[symbol].add(locale)

print("/*")
print(" * Copyright (c) 2026, PostgreSQL Global Development Group")
print(" * See the LICENSE file in the project root for more information.")
print(" */")
print()
print("package org.postgresql.jdbc.codec;")
print()
print("import java.util.Arrays;")
print("import java.util.Collections;")
print("import java.util.List;")
print()
print("/**")
print(" * The currency symbols of the locales that print three fraction digits.")
print(" *")
print(" * <p>{@code money} reaches the driver as the server's {@code lc_monetary} rendering, and one")
print(" * rendering cannot be read from its own shape: a single separator with exactly three digits after")
print(" * it and one to three before, {@code 1,234}, is 1234 where the locale prints no fraction and")
print(" * 1.234 where it prints three. {@link MoneyCodec} consults this list to tell those apart, and only")
print(" * there &mdash; a locale printing two fraction digits cannot produce that rendering, because")
print(" * {@code cash_out} always prints exactly {@code frac_digits} of them. That gate is what makes a")
print(" * symbol shared with a two-fraction-digit currency, as {@code L} and {@code £} are, harmless.</p>")
print(" *")
print(" * <p>Generated by {@code docker/bin/currency-fraction-digits} from glibc " + glibc + "; do not")
print(" * edit by hand. Re-run it when the server images move to a new glibc.</p>")
print(" */")
print("final class MoneyFractionDigits {")
print()
print("  /** Symbols whose locale prints three fraction digits, longest first so a prefix cannot shadow. */")
print("  private static final List<String> THREE = Collections.unmodifiableList(Arrays.asList(")
items = sorted(by, key=lambda s: (-len(s), s))
for i, symbol in enumerate(items):
    codepoints = " ".join("U+%04X" % ord(c) for c in symbol)
    locales = ", ".join(sorted(by[symbol]))
    end = "));" if i == len(items) - 1 else ","
    print(f'      "{symbol}"{end}'.ljust(24) + f"// {codepoints}  {locales}")
print()
print("  private MoneyFractionDigits() {")
print("  }")
print()
print("  /**")
print("   * Whether {@code literal} carries the symbol of a currency that prints three fraction digits.")
print("   *")
print("   * @param literal the money literal as the server rendered it")
print("   * @return {@code true} if the literal names such a currency")
print("   */")
print("  static boolean printsThreeFractionDigits(CharSequence literal) {")
print("    String text = literal.toString();")
print("    for (int i = 0, size = THREE.size(); i < size; i++) {")
print("      if (text.contains(THREE.get(i))) {")
print("        return true;")
print("      }")
print("    }")
print("    return false;")
print("  }")
print("}")
PY
CONTAINER
