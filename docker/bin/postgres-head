#!/usr/bin/env bash
set -euo pipefail

# Helper script to build PostgreSQL from source and start it for testing the
# PGJDBC driver. The image is drop-in compatible with the official postgres
# image, so it is started through the shared docker/postgres-server compose
# file and honours the same environment variables (SSL, XA, SCRAM, TZ,
# CREATE_REPLICAS, ...). See docker/bin/postgres-server for that list.
#
#    PG_BRANCH_NAME = "master" | "REL_17_STABLE" | ...  - postgres branch to build
#    PG_IMAGE       = image tag to build and run        - defaults to pgjdbc/postgres-devel:local

log () {
    echo "$@" 1>&2
}

main () {
    local branch_name="${PG_BRANCH_NAME:-master}"
    local image="${PG_IMAGE:-pgjdbc/postgres-devel:local}"

    local branch_json
    branch_json=$(curl -q -s -f "https://api.github.com/repos/postgres/postgres/branches/${branch_name}")
    branch_json_field () {
        jq -r -c <<<"${branch_json}" "${1}"
    }
    local branch_sha
    branch_sha="$(branch_json_field .commit.sha)"
    local branch_message
    branch_message="$(branch_json_field .commit.commit.message)"

    log "================================================================================"
    log "Will build branch ${branch_name} with SHA=${branch_sha}"
    log ""
    log "${branch_message}"
    log ""
    log "================================================================================"

    local script_dir
    script_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"

    log "Building ${image} for PostgreSQL built from source"
    docker build \
        --build-arg "GIT_SHA=${branch_sha}" \
        --build-arg "GIT_TAG=${branch_name}" \
        --tag "${image}" \
        "${script_dir}/../postgres-head"

    log "Starting the from-source server through the shared postgres-server compose"
    PG_IMAGE="${image}" exec "${script_dir}/postgres-server"
}

main "$@"
